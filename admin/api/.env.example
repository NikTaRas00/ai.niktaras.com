# Shared settings for the whole site. Copy to admin/api/.env on the server
# (gitignored, never deployed by a push).
#
# The admin panel and BOTH models read this file. A model's own api/.env wins
# if it sets a key; this file only fills keys that are missing or blank there.
# So the models' .env files can shrink to their model-specific keys:
#   NKT-1:  GEMINI_API_KEY, TAVILY_API_KEY, SITE_URL
#   NKT-2L: LOCAL_LLM_URL, LOCAL_LLM_KEY, LOCAL_LLM_MODEL, TAVILY_API_KEY, SITE_URL

# Code to enter the admin panel at ai.niktaras.com/admin/.
# Separate from UNLOCK_CODE -- this grants read access to every user's chats.
ADMIN_CODE=

# Lets a visitor keep chatting one message at a time after using their hourly
# limit. Leave blank to hard-block instead.
UNLOCK_CODE=

# MySQL database both models use (cPanel > MySQL Databases).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Verification-email sender. MAIL_FROM should be the mailbox address below.
MAIL_FROM=noreply@niktaras.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
