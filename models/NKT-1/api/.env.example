GEMINI_API_KEY=your-gemini-api-key-here

# Optional: enables live web search (Tavily, free tier, 1,000
# searches/month, no credit card required). Leave blank to disable
# — the chat still works fine, just without web search.
TAVILY_API_KEY=your-tavily-api-key-here

# Required for accounts/saved chats. Use the MySQL database, user, and
# password from your cPanel "MySQL Databases" page (see api/schema.sql
# for the tables to create). Leave DB_NAME/DB_USER blank to disable
# accounts entirely — the chat still works fine without them.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Required for account verification emails to work. SITE_URL is the base
# URL this app is deployed at (used to build the verification link);
# MAIL_FROM should be an address at your own domain for best deliverability.
SITE_URL=https://ai.niktaras.com/models/NKT-1
MAIL_FROM=noreply@niktaras.com

# Recommended: send via a real cPanel mailbox over SMTP (PHP's mail() is
# refused by many shared hosts). Create the mailbox in cPanel > Email
# Accounts, then use its "Connect Devices" settings. MAIL_FROM should be
# that same mailbox address. Leave blank to fall back to mail().
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: after a visitor uses their 5 messages/hour, they can keep
# chatting by entering this code (one message per correct entry). Leave
# blank to hard-block instead of offering a bypass.
UNLOCK_CODE=

# Required to use the site-wide admin panel at ai.niktaras.com/admin/. The
# panel reads ADMIN_CODE and the DB_* values from the first .env that has them
# (admin/api/.env, then NKT-1's, then NKT-2L's), so keep them identical across
# models. Deliberately separate from UNLOCK_CODE -- pick something only you
# know, since this grants full read access to every user's chats.
ADMIN_CODE=
