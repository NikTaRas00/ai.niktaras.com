# NKT-2L-specific settings. Shared settings (ADMIN_CODE, UNLOCK_CODE, DB_*,
# MAIL_FROM, SMTP_*) live once in admin/api/.env -- see admin/api/.env.example.

# Public HTTPS URL of the Tailscale Funnel pointing at LM Studio's server
# (no trailing slash, no /v1). Required.
LOCAL_LLM_URL=https://your-pc.your-tailnet.ts.net
# Sent as a Bearer token. Must match LM Studio's "Require Authentication" token.
LOCAL_LLM_KEY=
# Model identifier exactly as LM Studio lists it.
LOCAL_LLM_MODEL=qwen3-14b

# Optional: enables live web search (Tavily, free tier, 1,000
# searches/month, no credit card required). Leave blank to disable
# — the chat still works fine, just without web search.
TAVILY_API_KEY=your-tavily-api-key-here

# Base URL this app is deployed at (used to build the verification link
# emailed to new users).
SITE_URL=https://ai.niktaras.com/models/NKT-2L
